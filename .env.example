# Copy to .env.local (local) or set in your host's dashboard (e.g. Vercel → Settings → Environment Variables).
# The app works fully without any of these; they only switch on the AI tutor and the question generator.

# Provider: "anthropic" (default) or "openai-compatible"
AI_PROVIDER=anthropic

# Anthropic (Claude). Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Optional model override. Default: claude-opus-5-5
# AI_MODEL=claude-opus-5-5

# Only for AI_PROVIDER=openai-compatible:
# AI_BASE_URL=https://api.example.com/v1
# AI_API_KEY=
# AI_MODEL=your-model-name

# Phone/laptop sync. On Vercel this is added automatically when you connect a Blob store (Storage → Create → Blob, Private).
# BLOB_READ_WRITE_TOKEN=
# SYNC_BLOB_ACCESS=public   # only if the Blob store was created as Public
# Running on your own computer instead? Store sync copies in a folder:
# SYNC_LOCAL_DIR=./.sync
